@baseUrl = https://www.vekn.net
@apiUrl = {{baseUrl}}/api/vekn

@token = {{login.response.body.data.auth}}

# @name login
POST {{apiUrl}}/login
Content-Type: application/x-www-form-urlencoded

username={{veknLogin}}
&password={{veknPassword}}

###
# @name events
@eventId = {{events.response.body.data.events[0].event_id}}
GET {{apiUrl}}/event?date=2025-04-03
Authorization: Bearer {{token}}

###
# @name event_id
GET {{apiUrl}}/event/{{eventId}}
Authorization: Bearer {{token}}

